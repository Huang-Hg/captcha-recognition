# Publish only the reusable framework, essential configuration and documentation.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/pyproject.toml
!/src/
!/configs/

# Retain historical utilities locally; they are not runtime dependencies.
/src/dense_classifier.py
/src/qiangzhi_generator.py
/src/sr_rrdbnet.py
/src/licenses/

/configs/*
!/configs/architecture.json
!/configs/candidate.json
!/configs/public_data_sources.json
!/configs/training.json

**/__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env
.env.*
*.pem
*.key
